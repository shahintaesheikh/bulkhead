#!/usr/bin/env python3
"""Scripted treehouse CLI for bulkhead tests.

State lives in $FAKE_TREEHOUSE_STATE. Calls are logged to calls.log.

Assumed contract (see crates/bh/src/treehouse.rs):
  treehouse claim <repo-root> <task-id>   -> prints an absolute worktree path
  treehouse release <worktree>
"""

import os
import sys


def main(argv):
    state = os.environ.get("FAKE_TREEHOUSE_STATE")
    if not state:
        sys.stderr.write("fake-treehouse: FAKE_TREEHOUSE_STATE is not set\n")
        return 2
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "calls.log"), "a") as handle:
        handle.write(" ".join(argv) + "\n")

    args = list(argv)
    command = args.pop(0) if args else ""

    if command == "claim":
        task = args[1]
        worktree = os.path.join(state, "worktrees", task)
        os.makedirs(worktree, exist_ok=True)
        sys.stdout.write(worktree + "\n")
        return 0

    if command == "release":
        return 0

    sys.stderr.write("fake-treehouse: unknown command %r\n" % command)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
