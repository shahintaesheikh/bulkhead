#!/usr/bin/env python3
"""Scripted lavish-axi CLI for bulkhead tests."""

import os
import sys


def main(argv):
    state = os.environ.get("FAKE_LAVISH_STATE")
    if not state:
        sys.stderr.write("fake-lavish: FAKE_LAVISH_STATE is not set\n")
        return 2
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "calls.log"), "a") as handle:
        handle.write(" ".join(argv) + "\n")

    args = list(argv)
    command = args.pop(0) if args else ""

    if command == "publish":
        sys.stdout.write("https://lavish.example/review/1\n")
        return 0
    if command == "poll":
        sys.stdout.write("no feedback yet\n")
        return 0

    sys.stderr.write("fake-lavish: unknown command %r\n" % command)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
