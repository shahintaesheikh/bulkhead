#!/usr/bin/env python3
"""Scripted gh-axi CLI for bulkhead tests."""

import os
import sys


def main(argv):
    state = os.environ.get("FAKE_GHAXI_STATE")
    if not state:
        sys.stderr.write("fake-ghaxi: FAKE_GHAXI_STATE is not set\n")
        return 2
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "calls.log"), "a") as handle:
        handle.write(" ".join(argv) + "\n")

    args = list(argv)
    command = args.pop(0) if args else ""
    sub = args.pop(0) if args else ""

    if command == "pr" and sub == "create":
        sys.stdout.write("https://github.com/example/repo/pull/7\n")
        return 0
    if command == "pr" and sub == "merge":
        sys.stdout.write("merged\n")
        return 0
    if command == "pr" and sub == "checks":
        return 0

    sys.stderr.write("fake-ghaxi: unknown command %s %s\n" % (command, sub))
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
