#!/usr/bin/env python3
"""Scripted no-mistakes CLI for bulkhead tests."""

import os
import sys


def main(argv):
    state = os.environ.get("FAKE_NOMISTAKES_STATE")
    if not state:
        sys.stderr.write("fake-no-mistakes: FAKE_NOMISTAKES_STATE is not set\n")
        return 2
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "calls.log"), "a") as handle:
        handle.write(" ".join(argv) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
